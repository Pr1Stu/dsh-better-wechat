{
  "name": "@xmanrui/dsh-im",
  "version": "5.10.0",
  "icon": "./assets/logo-plugin-message-link-gradient.webp",
  "description": "将微信接入 DeepSeek Harness。 Connect WeChat to DeepSeek Harness.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "im",
    "instant-messaging",
    "chatbot",
    "wechat",
    "weixin"
  ],
  "author": "xmanrui (https://github.com/xmanrui)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pr1Stu/dsh-better-wechat.git"
  },
  "homepage": "https://github.com/Pr1Stu/dsh-better-wechat#readme",
  "bugs": {
    "url": "https://github.com/Pr1Stu/dsh-better-wechat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-im": "bin/dsh-im.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "assets",
    "bin",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "plugin-src",
    "examples/weixin-router",
    "examples/sim-weixin",
    "scripts/verify-injected-context.mjs",
    "scripts/verify-lan-management.mjs",
    "scripts/verify-model-setting.mjs",
    "scripts/verify-package.mjs",
    "scripts/verify-session-title-prefix.mjs",
    "CONTEXT.md",
    "docs/README.md",
    "docs/access-modes.md",
    "docs/bot-commands.md",
    "docs/client-integration.md",
    "docs/sim-weixin.md",
    "docs/context-enhancement.md",
    "docs/deferred-delivery.md",
    "docs/preset-workspaces.md",
    "docs/会话目录隔离.md",
    "docs/访问模式.md",
    "docs/上下文增强.md",
    "docs/机器人命令.md",
    "docs/检查与安装更新.md",
    "docs/checking-and-installing-updates.md",
    "src",
    "PROACTIVE_DELIVERY.md",
    "PROACTIVE_DELIVERY.en.md",
    "docs/client-integration.md",
    "docs/preset-workspaces.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node --test test/*.test.mjs test/channels/*/*.test.mjs",
    "check": "npm run build && npm test && node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "esbuild": "0.25.9",
    "markdown-it": "15.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "semver": "7.8.5"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  }
}
